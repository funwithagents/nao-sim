<!-- The live tier's scene: nao-viewer's empty scene plus one target for the head camera, a red
     pillar 1.5 m straight ahead of the robot, 1 m tall so it is in view whatever the robot's
     height. Emissive, so its red does not depend on the light. The robot is attached by
     nao-viewer (model.load_world). -->
<mujoco model="camera-target">
  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.55 0.65 0.75" rgb2="0.15 0.18 0.22"
             width="512" height="512"/>
    <texture name="checker" type="2d" builtin="checker" rgb1="0.62 0.64 0.66" rgb2="0.5 0.52 0.54"
             width="512" height="512"/>
    <material name="floor" texture="checker" texrepeat="8 8" texuniform="true"/>
    <material name="target" rgba="1 0 0 1" emission="1" specular="0"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 3" dir="0 0 -1" directional="true" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor"/>
    <geom name="target" type="box" pos="1.5 0 0.5" size="0.1 0.1 0.5" material="target"/>
  </worldbody>
</mujoco>
