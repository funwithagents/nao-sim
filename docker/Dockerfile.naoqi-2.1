# nao-sim: NAOqi 2.1.4.13 (NAO V4/V5) runtime container.
# Built locally only, by `nao-sim fetch-and-build-images 2.1`, from the image data folder's 2.1/ (the
# Choregraphe suite, the robot's animations package and the C++ SDK the relay is compiled against),
# which compose passes as the `image-data` build context.
# Never push this image: it contains Aldebaran's software.
#
# Three stages (specs/container/container.md, "The relay's build"): `suite` extracts NAOqi, `relay`
# compiles the native relay against the SDK's headers and the suite's libraries, and the final
# stage adds our files and only the relay's .so, so neither the compiler nor the SDK reaches it.

FROM --platform=linux/amd64 ubuntu:14.04 AS suite
ARG SUITE=choregraphe-suite-2.1.4.13-linux64.tar.gz

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libglib2.0-0 \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Extract the suite to /opt/naoqi (bin/, lib/, etc/naoqi/, share/).
COPY --from=image-data ${SUITE} /tmp/suite.tar.gz
RUN mkdir -p /opt && cd /opt \
 && tar -xzf /tmp/suite.tar.gz \
 && mv choregraphe-suite-2.1.4.13-linux64 naoqi \
 && rm /tmp/suite.tar.gz


# The native relay (specs/container/service-replacement.md, "Binary arguments: the native relay").
# g++ 4.8 from this base: the suite was built with gcc 4.6.3, same C++ library ABI. The SDK is the
# suite's own release, so its headers (module API, libqi, boost 1.55) match the suite's libraries.
FROM suite AS relay
ARG SDK=naoqi-sdk-2.1.4.13-linux64.tar.gz

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends g++ \
 && rm -rf /var/lib/apt/lists/*
COPY --from=image-data ${SDK} /tmp/sdk.tar.gz
RUN mkdir -p /tmp/sdk && tar -xzf /tmp/sdk.tar.gz -C /tmp/sdk --strip-components=1 --wildcards '*/include' \
 && rm /tmp/sdk.tar.gz
COPY relay/naosim_audiorelay.cpp /tmp/relay/
RUN cd /tmp/relay \
 && g++ -std=gnu++98 -O2 -fPIC -shared -DBOOST_SIGNALS_NO_DEPRECATION_WARNING -w \
      -I/tmp/sdk/include naosim_audiorelay.cpp -o libnaosim_audiorelay.so \
      -L/opt/naoqi/lib -lalcommon -lalvalue -lalerror -lqi -lqitype -lqimessaging \
      -lboost_thread -lboost_system \
 && LD_LIBRARY_PATH=/opt/naoqi/lib ldd -r libnaosim_audiorelay.so > ldd.txt 2>&1 \
 && if grep -E "undefined symbol|not found" ldd.txt; then exit 1; fi


FROM suite
# The nao-sim version the NaoSim service reports (compose passes ${NAO_SIM_VERSION:-dev}).
ARG NAO_SIM_VERSION=dev

# Our override modules (Python 2.7), loaded into the naoqi-bin process by the entrypoint.
COPY modules/ /opt/naoqi/modules/
# The native relay, loaded by the entrypoint with ALLauncher.launchLocal.
COPY --from=relay /tmp/relay/libnaosim_audiorelay.so /opt/naoqi/lib/nao-sim/libnaosim_audiorelay.so
# This version's boot procedure, and what it shares with the other one.
COPY entrypoint-2.1.sh /opt/naoqi/bin/nao-sim-entrypoint.sh
COPY entrypoint-lib.sh /opt/naoqi/bin/entrypoint-lib.sh
COPY healthcheck.sh /opt/naoqi/bin/nao-sim-healthcheck.sh

# The robot's animations package (extracted from the robot image). PackageManager installs every
# .pkg in share/naoqi/apps/ as a system package at boot, as a robot does with its factory packages.
COPY --from=image-data animations.pkg /opt/naoqi/share/naoqi/apps/animations.pkg

# naoqi-bin refuses to run as root. The package store is created here so that the compose volume
# mounted on it starts owned by nao.
RUN useradd -m -u 1000 -s /bin/bash nao && chown -R nao:nao /opt/naoqi \
 && mkdir -p /home/nao/.local/share/PackageManager && chown -R nao:nao /home/nao/.local

ENV NAOQI_HOME=/opt/naoqi \
    PATH=/opt/naoqi/bin:$PATH \
    LD_LIBRARY_PATH=/opt/naoqi/lib \
    PYTHONPATH=/opt/naoqi/lib:/opt/naoqi/modules \
    HOME=/home/nao \
    NAO_SIM_VERSION=${NAO_SIM_VERSION} \
    NAO_SIM_NAOQI_VERSION=2.1.4.13

USER nao
WORKDIR /opt/naoqi
# 9559: naoqi-bin broker; override modules register through it (naoqi.ALModule), so it is the only port
EXPOSE 9559
# Healthy once NaoSim.isReady answers true on the public port (specs/container/status-service.md).
HEALTHCHECK --interval=5s --timeout=5s --start-period=120s --retries=3 \
  CMD ["/opt/naoqi/bin/nao-sim-healthcheck.sh"]
ENTRYPOINT ["/opt/naoqi/bin/nao-sim-entrypoint.sh"]
