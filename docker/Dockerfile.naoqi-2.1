# nao-sim: NAOqi 2.1.4.13 (NAO V4/V5) runtime container.
# Built locally only, from docker/vendor/2.1/ (`uv run nao-sim-fetch-suite 2.1`): the Choregraphe
# suite and the robot's animations package.
# Never push this image: it contains Aldebaran's software.
FROM --platform=linux/amd64 ubuntu:14.04

# The nao-sim version the NaoSim service reports (compose passes ${NAO_SIM_VERSION:-dev}).
ARG NAO_SIM_VERSION=dev
ARG SUITE=choregraphe-suite-2.1.4.13-linux64.tar.gz

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libglib2.0-0 \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Extract the suite to /opt/naoqi (bin/, lib/, etc/naoqi/, share/).
COPY vendor/2.1/${SUITE} /tmp/suite.tar.gz
RUN mkdir -p /opt && cd /opt \
 && tar -xzf /tmp/suite.tar.gz \
 && mv choregraphe-suite-2.1.4.13-linux64 naoqi \
 && rm /tmp/suite.tar.gz

# Our override modules (Python 2.7), loaded into the naoqi-bin process by the entrypoint.
COPY modules/ /opt/naoqi/modules/
# This version's boot procedure, and what it shares with the other one.
COPY entrypoint-2.1.sh /opt/naoqi/bin/nao-sim-entrypoint.sh
COPY entrypoint-lib.sh /opt/naoqi/bin/entrypoint-lib.sh
COPY healthcheck.sh /opt/naoqi/bin/nao-sim-healthcheck.sh

# The robot's animations package (extracted from the robot image). PackageManager installs every
# .pkg in share/naoqi/apps/ as a system package at boot, as a robot does with its factory packages.
COPY vendor/2.1/animations.pkg /opt/naoqi/share/naoqi/apps/animations.pkg

# naoqi-bin refuses to run as root. The package store is created here so that the compose volume
# mounted on it starts owned by nao.
RUN useradd -m -u 1000 -s /bin/bash nao && chown -R nao:nao /opt/naoqi \
 && mkdir -p /home/nao/.local/share/PackageManager && chown -R nao:nao /home/nao/.local

ENV NAOQI_HOME=/opt/naoqi \
    PATH=/opt/naoqi/bin:$PATH \
    LD_LIBRARY_PATH=/opt/naoqi/lib \
    PYTHONPATH=/opt/naoqi/lib:/opt/naoqi/modules \
    HOME=/home/nao \
    NAO_SIM_VERSION=${NAO_SIM_VERSION} \
    NAO_SIM_NAOQI_VERSION=2.1.4.13

USER nao
WORKDIR /opt/naoqi
# 9559: naoqi-bin broker; override modules register through it (naoqi.ALModule), so it is the only port
EXPOSE 9559
# Healthy once NaoSim.isReady answers true on the public port (specs/status-service.md).
HEALTHCHECK --interval=5s --timeout=5s --start-period=120s --retries=3 \
  CMD ["/opt/naoqi/bin/nao-sim-healthcheck.sh"]
ENTRYPOINT ["/opt/naoqi/bin/nao-sim-entrypoint.sh"]
