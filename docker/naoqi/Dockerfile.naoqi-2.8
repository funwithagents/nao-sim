# naoqi-sim: NAOqi 2.8.7.4 (NAO V6) runtime container.
# Built locally only, by `naoqi-sim fetch-and-build-images 2.8`, from the image data folder's 2.8/ (the
# Choregraphe suite, the robot's animations package and the C++ SDK our modules are compiled against),
# which compose passes as the `image-data` build context.
# Never push this image: it contains Aldebaran's software.
#
# Three stages (specs/container/container.md, "The native build"): `suite` extracts NAOqi, `native`
# compiles our C++ NAOqi modules (each service's relay or front, docker/services/*/*.cpp) against the
# SDK's headers and the suite's libraries, and the final stage adds our files and only the .so files,
# so neither the compiler nor the SDK reaches it.

FROM --platform=linux/amd64 ubuntu:16.04 AS suite
ARG SUITE=choregraphe-suite-2.8.7.4-linux64.tar.gz
ARG SUITE_DIR=choregraphe-suite-2.8.7.4-linux64

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libglib2.0-0 libsqlite3-0 libdbus-1-3 libpulse0 \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Extract the suite to /opt/naoqi (bin/, lib/, etc/naoqi/, share/).
COPY --from=image-data ${SUITE} /tmp/suite.tar.gz
RUN mkdir -p /opt && cd /opt \
 && tar -xzf /tmp/suite.tar.gz \
 && mv ${SUITE_DIR} naoqi \
 && rm /tmp/suite.tar.gz


# Our C++ NAOqi modules (specs/container/service-replacement.md, "Binary arguments: the native relay"
# and "Task ids, wait and stop(id): a C++ front"), one lib<name>.so per docker/services/*/*.cpp.
# g++ 5.4 from this base, as the suite, with its old string ABI. The SDK is the suite's own release
# (aldebaran/nao6-doc-sdk), so its headers (module API, libqi, boost 1.64) match the suite's
# libraries, as 2.1's do.
FROM suite AS native
ARG SDK=naoqi-sdk-2.8.7.4-linux64.tar.gz

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends g++ \
 && rm -rf /var/lib/apt/lists/*
COPY --from=image-data ${SDK} /tmp/sdk.tar.gz
RUN mkdir -p /tmp/sdk && tar -xzf /tmp/sdk.tar.gz -C /tmp/sdk --strip-components=1 --wildcards '*/include' \
 && rm /tmp/sdk.tar.gz
# 2.8 switches on the fronts' 2.8 parts (NAOQISIM_NAOQI_28: _sayWithLocale, the hidden signals).
COPY services/*.h services/*/*.cpp /tmp/native/
RUN cd /tmp/native \
 && for src in *.cpp; do \
      m=${src%.cpp}; \
      g++ -std=gnu++14 -O2 -fPIC -shared -D_GLIBCXX_USE_CXX11_ABI=0 -DBOOST_SIGNALS_NO_DEPRECATION_WARNING \
        -DNAOQISIM_NAOQI_28 -w -I/tmp/sdk/include $src -o lib$m.so \
        -L/opt/naoqi/lib -lalcommon -lalvalue -lalerror -lqi -lboost_thread -lboost_system \
      && LD_LIBRARY_PATH=/opt/naoqi/lib ldd -r lib$m.so > ldd-$m.txt 2>&1 \
      && if grep -E "undefined symbol|not found" ldd-$m.txt; then exit 1; fi \
      || exit 1; \
    done


FROM suite
# The naoqi-sim version the NaoqiSim service reports (compose passes ${NAOQI_SIM_VERSION:-dev}).
ARG NAOQI_SIM_VERSION=dev

# Our override modules (Python 2.7, each service's core and shells), flat in one importable folder,
# loaded into NAOqi by the entrypoint.
COPY services/*/*.py /opt/naoqi/modules/
# Our C++ modules, loaded by the entrypoint with ALLauncher.launchLocal.
COPY --from=native /tmp/native/*.so /opt/naoqi/lib/naoqi-sim/
# This version's boot procedure, and what it shares with the other one.
COPY entrypoint-2.8.sh /opt/naoqi/bin/naoqi-sim-entrypoint.sh
COPY entrypoint-lib.sh /opt/naoqi/bin/entrypoint-lib.sh
COPY healthcheck.sh /opt/naoqi/bin/naoqi-sim-healthcheck.sh

# The robot's animations package (extracted from the robot image). PackageManager installs every
# .pkg in share/naoqi/apps/ as a system package at boot, as a robot does with its factory packages.
COPY --from=image-data animations.pkg /opt/naoqi/share/naoqi/apps/animations.pkg

# The desktop 2.8 suite defaults to Pepper's model; make the virtual robot a NAO H25 V6.
RUN sed -i 's/JULIETTEY20B2C.xml/NAOH25V60.xml/' /opt/naoqi/etc/naoqi/ALRobotModel.xml

# naoqi-bin refuses to run as root. The package store is created here so that the compose volume
# mounted on it starts owned by nao.
RUN useradd -m -u 1000 -s /bin/bash nao && chown -R nao:nao /opt/naoqi \
 && mkdir -p /home/nao/.local/share/PackageManager && chown -R nao:nao /home/nao/.local

ENV NAOQI_HOME=/opt/naoqi \
    PATH=/opt/naoqi/bin:$PATH \
    LD_LIBRARY_PATH=/opt/naoqi/lib \
    PYTHONPATH=/opt/naoqi/lib:/opt/naoqi/modules \
    HOME=/home/nao \
    NAOQI_SIM_VERSION=${NAOQI_SIM_VERSION} \
    NAOQI_SIM_NAOQI_VERSION=2.8.7.4

USER nao
WORKDIR /opt/naoqi
# 9559: the suite's qi-secure-gateway (core package), which relays every service process (naoqi-bin
# itself listens on 127.0.0.1:9558). Single public port, as on a real NAO 6.
EXPOSE 9559
# Healthy once NaoqiSim.isReady answers true on the public port (specs/container/status-service.md).
HEALTHCHECK --interval=5s --timeout=5s --start-period=120s --retries=3 \
  CMD ["/opt/naoqi/bin/naoqi-sim-healthcheck.sh"]
ENTRYPOINT ["/opt/naoqi/bin/naoqi-sim-entrypoint.sh"]
