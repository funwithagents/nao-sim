# nao-sim: NAOqi 2.8.7.4 (NAO V6) runtime container.
# Built locally only, from docker/vendor/2.8/ (`uv run nao-sim-fetch-suite 2.8`): the Choregraphe
# suite and the robot's animations package.
# Never push this image: it contains Aldebaran's software.
FROM --platform=linux/amd64 ubuntu:16.04

ARG SUITE=choregraphe-suite-2.8.7.4-linux64.tar.gz
ARG SUITE_DIR=choregraphe-suite-2.8.7.4-linux64

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libglib2.0-0 libsqlite3-0 libdbus-1-3 libpulse0 \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Extract the suite to /opt/naoqi (bin/, lib/, etc/naoqi/, share/).
COPY vendor/2.8/${SUITE} /tmp/suite.tar.gz
RUN mkdir -p /opt && cd /opt \
 && tar -xzf /tmp/suite.tar.gz \
 && mv ${SUITE_DIR} naoqi \
 && rm /tmp/suite.tar.gz

# Our override modules (Python 2.7), loaded into the naoqi-bin process by the entrypoint.
COPY modules/ /opt/naoqi/modules/
COPY entrypoint.sh /opt/naoqi/bin/nao-sim-entrypoint.sh

# The robot's animations package (extracted from the robot image). PackageManager installs every
# .pkg in share/naoqi/apps/ as a system package at boot, as a robot does with its factory packages.
COPY vendor/2.8/animations.pkg /opt/naoqi/share/naoqi/apps/animations.pkg

# The desktop 2.8 suite defaults to Pepper's model; make the virtual robot a NAO H25 V6.
RUN sed -i 's/JULIETTEY20B2C.xml/NAOH25V60.xml/' /opt/naoqi/etc/naoqi/ALRobotModel.xml

# naoqi-bin refuses to run as root. The package store is created here so that the compose volume
# mounted on it starts owned by nao.
RUN useradd -m -u 1000 -s /bin/bash nao && chown -R nao:nao /opt/naoqi \
 && mkdir -p /home/nao/.local/share/PackageManager && chown -R nao:nao /home/nao/.local

ENV NAOQI_HOME=/opt/naoqi \
    PATH=/opt/naoqi/bin:$PATH \
    LD_LIBRARY_PATH=/opt/naoqi/lib \
    PYTHONPATH=/opt/naoqi/lib:/opt/naoqi/modules \
    HOME=/home/nao \
    NAO_SIM_LISTEN_URL="tcp://127.0.0.1:9558" \
    NAO_SIM_INTERNAL_PORT="9558" \
    NAO_SIM_READY_SERVICE="ALPanoramaCompass" \
    NAO_SIM_RESTART_SERVICES="expressivity.autonomousabilitiesmodules" \
    NAO_SIM_EXIT_MODULES="ALTextToSpeech" \
    NAO_SIM_MODULES="nao_sim_tts_qiservice" \
    NAO_SIM_DEFER_MODULES=""

USER nao
WORKDIR /opt/naoqi
# 9559: the suite's qi-secure-gateway (core package), which relays every service process (naoqi-bin
# itself listens on 127.0.0.1:9558). Single public port, as on a real NAO 6.
EXPOSE 9559
ENTRYPOINT ["/opt/naoqi/bin/nao-sim-entrypoint.sh"]
