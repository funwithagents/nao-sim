# nao-sim: NAOqi 2.8.7.4 (NAO V6) runtime container.
# Built locally only, by `nao-sim fetch-and-build-images 2.8`, from the image data folder's 2.8/ (the
# Choregraphe suite, the robot's animations package and the files the relay is compiled against),
# which compose passes as the `image-data` build context.
# Never push this image: it contains Aldebaran's software.
#
# Three stages (specs/container/container.md, "The relay's build"): `suite` extracts NAOqi, `relay`
# compiles the native relay against the headers and the suite's libraries, and the final stage
# adds our files and only the relay's .so, so neither the compiler nor the headers reach it.

FROM --platform=linux/amd64 ubuntu:16.04 AS suite
ARG SUITE=choregraphe-suite-2.8.7.4-linux64.tar.gz
ARG SUITE_DIR=choregraphe-suite-2.8.7.4-linux64

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libglib2.0-0 libsqlite3-0 libdbus-1-3 libpulse0 \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Extract the suite to /opt/naoqi (bin/, lib/, etc/naoqi/, share/).
COPY --from=image-data ${SUITE} /tmp/suite.tar.gz
RUN mkdir -p /opt && cd /opt \
 && tar -xzf /tmp/suite.tar.gz \
 && mv ${SUITE_DIR} naoqi \
 && rm /tmp/suite.tar.gz


# The native relay (specs/container/service-replacement.md, "Binary arguments: the native relay").
# g++ 5.4 from this base, as the suite, with its old string ABI. The only public 2.8 SDK (2.8.5.10)
# is older than the suite, so only its module API headers are used: libqi (our fork, at tag
# qi-framework-v1.8.7) and boost 1.64 come first on the include path, at the suite's versions.
FROM suite AS relay
ARG SDK=naoqi-sdk-2.8.5.10-linux64.tar.gz
ARG LIBQI=libqi-7f3e1394cb26126b26fa7ff54d2de1371a1c9f96.tar.gz
ARG BOOST=boost_1_64_0.tar.bz2

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends g++ bzip2 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=image-data ${SDK} /tmp/sdk.tar.gz
COPY --from=image-data ${LIBQI} /tmp/libqi.tar.gz
COPY --from=image-data ${BOOST} /tmp/boost.tar.bz2
RUN mkdir -p /tmp/sdk /tmp/libqi /tmp/boost \
 && tar -xzf /tmp/sdk.tar.gz -C /tmp/sdk --strip-components=1 --wildcards '*/include' \
 && tar -xzf /tmp/libqi.tar.gz -C /tmp/libqi --strip-components=1 --wildcards '*/qi' '*/ka' \
 && tar -xjf /tmp/boost.tar.bz2 -C /tmp/boost --strip-components=1 --wildcards '*/boost' \
 && rm /tmp/sdk.tar.gz /tmp/libqi.tar.gz /tmp/boost.tar.bz2
COPY relay/naosim_audiorelay.cpp /tmp/relay/
RUN cd /tmp/relay \
 && g++ -std=gnu++14 -O2 -fPIC -shared -D_GLIBCXX_USE_CXX11_ABI=0 -DBOOST_SIGNALS_NO_DEPRECATION_WARNING -w \
      -I/tmp/libqi -I/tmp/boost -I/tmp/sdk/include naosim_audiorelay.cpp -o libnaosim_audiorelay.so \
      -L/opt/naoqi/lib -lalcommon -lalvalue -lalerror -lqi -lboost_thread -lboost_system \
 && LD_LIBRARY_PATH=/opt/naoqi/lib ldd -r libnaosim_audiorelay.so > ldd.txt 2>&1 \
 && if grep -E "undefined symbol|not found" ldd.txt; then exit 1; fi


FROM suite
# The nao-sim version the NaoSim service reports (compose passes ${NAO_SIM_VERSION:-dev}).
ARG NAO_SIM_VERSION=dev

# Our override modules (Python 2.7), loaded into the naoqi-bin process by the entrypoint.
COPY modules/ /opt/naoqi/modules/
# The native relay, loaded by the entrypoint with ALLauncher.launchLocal.
COPY --from=relay /tmp/relay/libnaosim_audiorelay.so /opt/naoqi/lib/nao-sim/libnaosim_audiorelay.so
# This version's boot procedure, and what it shares with the other one.
COPY entrypoint-2.8.sh /opt/naoqi/bin/nao-sim-entrypoint.sh
COPY entrypoint-lib.sh /opt/naoqi/bin/entrypoint-lib.sh
COPY healthcheck.sh /opt/naoqi/bin/nao-sim-healthcheck.sh

# The robot's animations package (extracted from the robot image). PackageManager installs every
# .pkg in share/naoqi/apps/ as a system package at boot, as a robot does with its factory packages.
COPY --from=image-data animations.pkg /opt/naoqi/share/naoqi/apps/animations.pkg

# The desktop 2.8 suite defaults to Pepper's model; make the virtual robot a NAO H25 V6.
RUN sed -i 's/JULIETTEY20B2C.xml/NAOH25V60.xml/' /opt/naoqi/etc/naoqi/ALRobotModel.xml

# naoqi-bin refuses to run as root. The package store is created here so that the compose volume
# mounted on it starts owned by nao.
RUN useradd -m -u 1000 -s /bin/bash nao && chown -R nao:nao /opt/naoqi \
 && mkdir -p /home/nao/.local/share/PackageManager && chown -R nao:nao /home/nao/.local

ENV NAOQI_HOME=/opt/naoqi \
    PATH=/opt/naoqi/bin:$PATH \
    LD_LIBRARY_PATH=/opt/naoqi/lib \
    PYTHONPATH=/opt/naoqi/lib:/opt/naoqi/modules \
    HOME=/home/nao \
    NAO_SIM_VERSION=${NAO_SIM_VERSION} \
    NAO_SIM_NAOQI_VERSION=2.8.7.4

USER nao
WORKDIR /opt/naoqi
# 9559: the suite's qi-secure-gateway (core package), which relays every service process (naoqi-bin
# itself listens on 127.0.0.1:9558). Single public port, as on a real NAO 6.
EXPOSE 9559
# Healthy once NaoSim.isReady answers true on the public port (specs/container/status-service.md).
HEALTHCHECK --interval=5s --timeout=5s --start-period=120s --retries=3 \
  CMD ["/opt/naoqi/bin/nao-sim-healthcheck.sh"]
ENTRYPOINT ["/opt/naoqi/bin/nao-sim-entrypoint.sh"]
